diff --git a/meson.build b/meson.build
index b3da9d7b..c766b289 100644
--- a/meson.build
+++ b/meson.build
@@ -97,6 +97,11 @@ cargs = [
   '-DBUILDING_LIBSLIRP',
 ]
 
+# A static libslirp (QEMU's subproject fallback) has no DLL to import from or
+# export to: on Windows SLIRP_EXPORT must be empty for it and its users.
+static_cargs = get_option('default_library') == 'static' ? ['-DLIBSLIRP_STATIC'] : []
+cargs += static_cargs
+
 if glib_static == true
   # This likely only applies to Windows... but... need to ensure that
   # glib-2.0 doesn't set import/export defines.
@@ -272,6 +277,7 @@ endif
 
 libslirp_libdep = declare_dependency(
   link_with : lib,
+  compile_args : static_cargs,
   include_directories : [include_directories('src'), include_directories('.')],
 )
 meson.override_dependency('slirp', libslirp_libdep)
diff --git a/src/misc.c b/src/misc.c
